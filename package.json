{
  "name": "mischief",
  "version": "0.1.1",
  "description": "Seeded, guard-railed monkey testing for web apps in a real browser. Every finding replays from its seed; a run that could not reach the page it asked for fails instead of passing.",
  "keywords": [
    "qa",
    "monkey-testing",
    "chaos",
    "e2e",
    "playwright",
    "cdp",
    "fuzzing",
    "accessibility"
  ],
  "license": "MIT",
  "author": "ca1773130n",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ca1773130n/Mischief.git"
  },
  "bugs": {
    "url": "https://github.com/ca1773130n/Mischief/issues"
  },
  "homepage": "https://github.com/ca1773130n/Mischief#readme",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "mischief": "./bin/mischief.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./presets": "./src/presets.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "examples",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "playwright-core": "^1.49.0"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  }
}
